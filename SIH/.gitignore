# DisasterGuard — .gitignore

# Node.js dependencies
node_modules/
backend/node_modules/

# SQLite database (regenerated by seed on first boot)
backend/data/
*.db
*.db-wal
*.db-shm

# Environment variables
.env
backend/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
build/
dist/

# Test scratch files
_seed_wrapper.js
_seed_debug.js
_precompute_hashes.js
